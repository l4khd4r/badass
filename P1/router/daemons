# zebra: core manager, installs routes from the protocols into the kernel
zebra=yes
# BGP: used in P3 (EVPN + route reflector)
bgpd=yes
# OSPF: P3 underlay
ospfd=yes
# IS-IS: required by the subject
isisd=yes


ospf6d=no
ripd=no
ripngd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
